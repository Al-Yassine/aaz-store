[debug] [2026-03-06T22:27:01.760Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/aazstore-71de7/rulesets {"name":"projects/aazstore-71de7/rulesets/cc671e66-f5e8-46f1-93e3-81b31de570f4","source":{"files":[{"content":"rules_version='2'\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    \n    // Helper function to check if user is admin\n    function isAdmin() {\n      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';\n    }\n    \n    // Helper function to check if user is authenticated\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n    \n    // Helper function to check if user owns the document\n    function isOwner(userId) {\n      return request.auth.uid == userId;\n    }\n\n    // Basic guest order validation to allow unauthenticated checkout safely.\n    function isValidGuestOrderCreate() {\n      return request.resource.data.isGuest == true\n        && request.resource.data.userId == null\n        && request.resource.data.status == 'pending'\n        && request.resource.data.products is list\n        && request.resource.data.products.size() > 0\n        && request.resource.data.totalPrice is number\n        && request.resource.data.subtotal is number\n        && request.resource.data.deliveryFee is number\n        && request.resource.data.deliveryRegion is string\n        && request.resource.data.paymentMethod is string\n        && request.resource.data.deliveryInfo is map\n        && request.resource.data.deliveryInfo.fullName is string\n        && request.resource.data.deliveryInfo.phone is string\n        && request.resource.data.deliveryInfo.quartier is string\n        && request.resource.data.deliveryInfo.address is string;\n    }\n\n    // Users collection\n    match /users/{userId} {\n      // Users can read their own document\n      // Admins can read all user documents\n      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());\n      \n      // Users can create their own document (during signup)\n      allow create: if isAuthenticated() && isOwner(userId);\n      \n      // Users can update their own document (except role field)\n      // Admins can update any user document\n      allow update: if isAuthenticated() && (\n        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||\n        isAdmin()\n      );\n      \n      // Only admins can delete users\n      allow delete: if isAuthenticated() && isAdmin();\n    }\n\n    // Orders collection\n    match /orders/{orderId} {\n      // Users can read their own orders\n      // Admins can read all orders\n      allow read: if isAuthenticated() && (\n        isAdmin() || \n        resource.data.userId == request.auth.uid\n      );\n      \n      // Authenticated users can create orders for themselves.\n      // Guest-shaped orders are allowed with restricted fields, even if an auth token exists.\n      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid)\n        || isValidGuestOrderCreate();\n      \n      // Only admins can update orders (for status changes)\n      allow update: if isAuthenticated() && isAdmin();\n      \n      // Only admins can delete orders\n      allow delete: if isAuthenticated() && isAdmin();\n    }\n\n    // Deny all other access by default\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-03-06T22:27:00.088527Z","metadata":{"services":["cloud.firestore"]}}
