rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Basic guest order validation to allow unauthenticated checkout safely.
    function isValidGuestOrderCreate() {
      return request.resource.data.isGuest == true
        && request.resource.data.userId == null
        && request.resource.data.status == 'pending'
        && request.resource.data.products is list
        && request.resource.data.products.size() > 0
        && request.resource.data.totalPrice is number
        && request.resource.data.subtotal is number
        && request.resource.data.deliveryFee is number
        && request.resource.data.deliveryRegion is string
        && request.resource.data.paymentMethod is string
        && request.resource.data.deliveryInfo is map
        && request.resource.data.deliveryInfo.fullName is string
        && request.resource.data.deliveryInfo.phone is string
        && request.resource.data.deliveryInfo.quartier is string
        && request.resource.data.deliveryInfo.address is string;
    }

      // Contact message payload validation for public contact form submissions.
      function isValidContactMessageCreate() {
        return request.resource.data.keys().hasOnly([
          'name',
          'email',
          'subject',
          'message',
          'createdAt',
          'status'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 5000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt is timestamp;
      }

    // Users collection
    match /users/{userId} {
      // Users can read their own document
      // Admins can read all user documents
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      
      // Users can create their own document (during signup)
      allow create: if isAuthenticated() && isOwner(userId);
      
      // Users can update their own document (except role field)
      // Admins can update any user document
      allow update: if isAuthenticated() && (
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
        isAdmin()
      );
      
      // Only admins can delete users
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      // Users can read their own orders
      // Admins can read all orders
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      
      // Authenticated users can create orders for themselves.
      // Guest-shaped orders are allowed with restricted fields, even if an auth token exists.
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid)
        || isValidGuestOrderCreate();
      
      // Only admins can update orders (for status changes)
      allow update: if isAuthenticated() && isAdmin();
      
      // Only admins can delete orders
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Contact messages collection
    match /contactMessages/{messageId} {
      // Public submissions allowed for the contact form.
      allow create: if isValidContactMessageCreate();

      // Admin-only management in dashboard.
      allow read, update, delete: if isAuthenticated() && isAdmin();
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
