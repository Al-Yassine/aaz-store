# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project values

# Firebase API Key (from Firebase Console > Project Settings > General)
REACT_APP_FIREBASE_API_KEY=your_api_key_here

# Firebase Auth Domain (usually: your-project-id.firebaseapp.com)
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Firebase Project ID
REACT_APP_FIREBASE_PROJECT_ID=your-project-id

# Firebase Storage Bucket (usually: your-project-id.appspot.com)
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Firebase Messaging Sender ID (from Firebase Console > Project Settings > Cloud Messaging)
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id

# Firebase App ID (from Firebase Console > Project Settings > General)
REACT_APP_FIREBASE_APP_ID=your_app_id

# Firebase Measurement ID (optional, for Analytics)
REACT_APP_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Use Firebase Emulators in development (optional)
REACT_APP_USE_EMULATORS=false
